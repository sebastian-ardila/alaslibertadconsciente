---
import '@fontsource-variable/josefin-sans/wght.css';
import '@fontsource-variable/josefin-sans/wght-italic.css';
import '@fontsource-variable/hanken-grotesk/index.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import ogSrc from '../assets/img/mockup-dispositivos.png';
import { PRODUCT, CHECKOUT_URL, hero } from '../content/landing';

const title = `${PRODUCT.name} | ${PRODUCT.brand}`;
const description = `${hero.subtitle}. Ebook con meditaciones, ejercicios, cartas angelicales y guía de cierre de ciclos. Acceso inmediato por $${PRODUCT.price} ${PRODUCT.currency}.`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({ src: ogSrc, width: 1200, format: 'jpg', quality: 82 });
const ogUrl = new URL(og.src, Astro.site).href;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: PRODUCT.name,
  description,
  image: ogUrl,
  brand: { '@type': 'Brand', name: PRODUCT.brand },
  author: { '@type': 'Person', name: 'Claudia Palacio' },
  offers: {
    '@type': 'Offer',
    price: PRODUCT.price,
    priceCurrency: PRODUCT.currency,
    availability: 'https://schema.org/InStock',
    url: CHECKOUT_URL,
  },
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a1733" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />

    <meta property="og:type" content="product" />
    <meta property="og:locale" content="es_LA" />
    <meta property="og:site_name" content={PRODUCT.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(og.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(og.attributes.height ?? 675)} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
