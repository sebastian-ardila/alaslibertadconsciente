---
import { Picture } from 'astro:assets';
import img from '../../assets/img/mujer-ventana.png';
import { pain } from '../../content/landing';
import ArchFrame from '../ArchFrame.astro';
---
<section class="pain sec is-deep" aria-labelledby="pain-title">
  <div class="wrap">
    <div class="pain__top">
      <div class="pain__media">
        <ArchFrame tone="azul">
          <Picture src={img} formats={['avif', 'webp']} widths={[480, 720, 1024]} sizes="(min-width: 900px) 34vw, 80vw" alt="Mujer sentada junto a una ventana en un día de lluvia, pensativa" />
        </ArchFrame>
      </div>
      <div class="pain__copy">
        <h2 id="pain-title" class="t-display t-3">{pain.title}</h2>
        <div class="pain__intro t-1">
          {pain.intro.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>

    <ul class="pain__points" role="list" data-scrub-lines>
      {pain.points.map((p) => (
        <li><span class="pain__dash" aria-hidden="true"></span>{p}</li>
      ))}
    </ul>

    <p class="pain__closing t-lirica">{pain.closing}</p>
  </div>
</section>

<style>
  .pain__top {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
  }
  .pain__media { max-width: 26rem; width: 100%; }
  .pain__media :global(.arch__clip) { background: #0d1a3a; }
  .pain__media :global(img) { filter: saturate(0.55) brightness(0.9); }
  .pain__copy h2 { color: var(--perla); max-width: 15ch; }
  .pain__intro { margin-top: 2rem; display: grid; gap: 1rem; color: var(--niebla); max-width: 38ch; }

  .pain__points {
    margin-top: clamp(4rem, 9vw, 7rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(2rem, 5vw, 5rem);
  }
  .pain__points li {
    display: flex;
    gap: 1.1rem;
    align-items: baseline;
    padding-block: 1.4rem;
    border-top: 1px solid rgb(180 192 216 / 0.16);
    font-size: var(--s-1);
    line-height: 1.4;
    color: var(--alba);
  }
  .pain__dash {
    flex: none;
    width: 1.1rem;
    height: 1px;
    background: var(--oro);
    transform: translateY(-0.35em);
  }

  .pain__closing {
    margin: clamp(4rem, 9vw, 7rem) auto 0;
    max-width: 30ch;
    text-align: center;
    font-size: var(--s-3);
    line-height: 1.2;
    color: var(--oro-claro);
  }
  @media (max-width: 899px) {
    .pain__top { grid-template-columns: 1fr; }
    .pain__media { width: 72%; margin-inline: auto; }
  }
  @media (max-width: 699px) {
    .pain__points { grid-template-columns: 1fr; }
    .pain__closing { font-size: var(--s-2); }
  }
</style>
