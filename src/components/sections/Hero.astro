---
import { Picture } from 'astro:assets';
import ebook from '../../assets/img/ebook-portada.png';
import { hero, cta } from '../../content/landing';
import CtaButton from '../CtaButton.astro';
import Starfield from '../Starfield.astro';
---
<section class="hero is-night" id="inicio" aria-labelledby="hero-title">
  <div class="hero__sky" aria-hidden="true"></div>
  <Starfield seed={11} />

  <div class="hero__grid wrap">
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title t-display" data-split>
        <span class="line"><span>Un Encuentro</span></span>
        <span class="line"><span>con los 7</span></span>
        <span class="line"><span>Arcángeles</span></span>
      </h1>
      <p class="hero__sub t-lirica t-2" data-hero-fade>{hero.subtitle}</p>
    </div>

    <div class="hero__book" data-hero-book>
      <svg class="hero__orbits" viewBox="0 0 600 600" aria-hidden="true" data-depth="0.25">
        <circle cx="300" cy="300" r="290" />
        <circle cx="300" cy="300" r="232" stroke-dasharray="1 7" />
        <circle cx="300" cy="300" r="176" />
        <path class="hero__spark" d="M300 0c1.4 13 7 18.6 20 20-13 1.4-18.6 7-20 20-1.4-13-7-18.6-20-20 13-1.4 18.6-7 20-20z" />
      </svg>
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="hero__cover" data-tilt>
        <Picture
          src={ebook}
          formats={['avif', 'webp']}
          widths={[360, 540, 720, 1000]}
          sizes="(min-width: 1000px) 38vw, 78vw"
          alt="Portada del ebook Un Encuentro con los 7 Arcángeles, de Alas Libertad Consciente"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>

    <div class="hero__cta" data-hero-fade>
      <p class="hero__lead t-1">{hero.lead}</p>
      <p class="hero__body">{hero.body}</p>
      <CtaButton label={cta.start} id="hero" />
      <p class="hero__closing muted">{hero.closing}</p>
    </div>
  </div>

  <a class="hero__scroll" href="#video" aria-label="Seguir leyendo">
    <span aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding-block: calc(5.5rem + env(safe-area-inset-top)) clamp(4rem, 7vw, 6rem);
    overflow: hidden;
    display: grid;
    align-items: center;
  }
  .hero__sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 55% at 72% 40%, rgb(0 74 173 / 0.55), transparent 70%),
      radial-gradient(40% 40% at 12% 95%, rgb(0 74 173 / 0.25), transparent 70%),
      linear-gradient(180deg, var(--noche-hondo), var(--noche) 60%);
  }
  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    grid-template-areas:
      'copy book'
      'cta  book';
    column-gap: clamp(2rem, 5vw, 5rem);
    row-gap: 2rem;
    align-items: end;
  }
  .hero__copy { grid-area: copy; }
  .hero__book { grid-area: book; align-self: center; }
  .hero__cta { grid-area: cta; align-self: start; }

  .hero__title {
    font-size: clamp(3rem, 0.6rem + 5.6vw, 7.25rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
    color: var(--perla);
  }
  .hero__title .line { display: block; overflow: hidden; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .hero__title .line > span { display: inline-block; }
  .hero__sub {
    margin-top: 1.25rem;
    max-width: 30ch;
    color: var(--oro-claro);
  }

  .hero__lead { max-width: 34ch; color: var(--alba); }
  .hero__body { margin-top: 0.75rem; max-width: 44ch; color: var(--niebla); }
  .hero__cta :global(.btn) { margin-top: 1.5rem; }
  .hero__closing { margin-top: 1.1rem; font-size: var(--s--1); max-width: 40ch; }

  .hero__book {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
  }
  .hero__orbits {
    position: absolute;
    inset: -6%;
    width: 112%;
    max-width: none;
    height: 112%;
    overflow: visible;
  }
  .hero__orbits circle { fill: none; stroke: var(--oro); stroke-width: 1; opacity: 0.5; vector-effect: non-scaling-stroke; }
  .hero__spark { fill: var(--oro-claro); }
  .hero__glow {
    position: absolute;
    inset: 18%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(230 205 148 / 0.4), rgb(0 74 173 / 0.15) 60%, transparent);
    filter: blur(20px);
  }
  .hero__cover {
    position: relative;
    width: 86%;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .hero__cover :global(img) {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 40px 50px rgb(0 0 0 / 0.55));
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
  }
  .hero__scroll span {
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(var(--oro), transparent);
    animation: drip 2.4s var(--ease-out) infinite;
    transform-origin: top;
  }
  @keyframes drip { 0% { transform: scaleY(0); } 60% { transform: scaleY(1); opacity: 1; } 100% { transform: scaleY(1); opacity: 0; } }

  @media (max-width: 899px) {
    .hero__grid {
      grid-template-columns: 1fr;
      grid-template-areas: 'copy' 'book' 'cta';
      row-gap: 1rem;
    }
    .hero__book { width: min(100%, 26rem); margin-inline: auto; }
    .hero__sub { max-width: 30ch; }
    .hero__scroll { display: none; }
  }
</style>
