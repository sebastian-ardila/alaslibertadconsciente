---
import { Picture } from 'astro:assets';
import ebook from '../../assets/img/ebook-portada.png';
import { hero, cta, PRODUCT, price } from '../../content/landing';
import CtaButton from '../CtaButton.astro';
import Starfield from '../Starfield.astro';
---
<section class="hero is-night" id="inicio" aria-labelledby="hero-title">
  <div class="hero__sky" aria-hidden="true"></div>
  <Starfield seed={11} />

  <div class="hero__grid wrap">
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title t-display">
        <span class="line"><span>Un Encuentro</span></span>
        <span class="line"><span>con los 7 Arcángeles</span></span>
      </h1>
      <p class="hero__sub t-lirica" data-hero-fade>{hero.subtitle}</p>

      <div class="hero__cta" data-hero-fade>
        <CtaButton label={cta.start} id="hero" />
        <p class="hero__price">
          <s><span class="sr-only">Antes </span>${PRODUCT.regularPrice}</s>
          <span class="hero__now">${PRODUCT.price} {PRODUCT.currency}</span>
          <span class="hero__access">{price.access}</span>
        </p>
      </div>
    </div>

    <div class="hero__book" data-hero-book>
      <svg class="hero__orbits" viewBox="0 0 600 600" aria-hidden="true">
        <circle cx="300" cy="300" r="290" />
        <circle cx="300" cy="300" r="232" stroke-dasharray="1 7" />
        <circle cx="300" cy="300" r="176" />
        <path class="hero__spark" d="M300 0c1.4 13 7 18.6 20 20-13 1.4-18.6 7-20 20-1.4-13-7-18.6-20-20 13-1.4 18.6-7 20-20z" />
      </svg>
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="hero__cover" data-tilt>
        <Picture
          src={ebook}
          formats={['avif', 'webp']}
          widths={[360, 540, 720, 1000]}
          sizes="(min-width: 1000px) 38vw, 78vw"
          alt="Portada del ebook Un Encuentro con los 7 Arcángeles, de Alas Libertad Consciente"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>

  <a class="hero__scroll" href="#video" aria-label="Seguir leyendo">
    <span aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding-block: calc(7rem + env(safe-area-inset-top)) clamp(4.5rem, 8vh, 6.5rem);
    overflow: hidden;
    display: grid;
    align-items: center;
  }
  .hero__sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 55% at 72% 45%, rgb(0 74 173 / 0.55), transparent 70%),
      radial-gradient(40% 40% at 12% 95%, rgb(0 74 173 / 0.25), transparent 70%),
      linear-gradient(180deg, var(--noche-hondo), var(--noche) 60%);
  }
  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  /* El título se limita también por la altura de la pantalla, para laptops bajas */
  .hero__title {
    font-size: min(clamp(2.75rem, 0.9rem + 4.9vw, 6.25rem), 10.5vh);
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--perla);
  }
  .hero__title .line { display: block; overflow: hidden; padding-bottom: 0.1em; margin-bottom: -0.1em; }
  .hero__title .line > span { display: inline-block; }
  .hero__sub {
    margin-top: clamp(1.25rem, 3vh, 2rem);
    max-width: 28ch;
    font-size: min(var(--s-2), 4.2vh);
    color: var(--oro-claro);
  }

  .hero__cta {
    margin-top: clamp(2rem, 5.5vh, 3.25rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }
  .hero__price {
    display: grid;
    grid-template-columns: auto auto;
    column-gap: 0.6rem;
    align-items: baseline;
    line-height: 1.3;
  }
  .hero__price s { color: var(--niebla); font-size: var(--s--1); text-decoration-color: var(--gema-rubi); text-decoration-thickness: 2px; }
  .hero__now { font-family: var(--f-display); font-weight: 600; font-size: var(--s-1); color: var(--perla); }
  .hero__access { grid-column: 1 / -1; font-size: var(--s--1); color: var(--niebla); }

  .hero__book {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 72vh);
    aspect-ratio: 1;
    justify-self: center;
  }
  .hero__orbits {
    position: absolute;
    inset: -6%;
    width: 112%;
    max-width: none;
    height: 112%;
    overflow: visible;
  }
  .hero__orbits circle { fill: none; stroke: var(--oro); stroke-width: 1; opacity: 0.5; vector-effect: non-scaling-stroke; }
  .hero__spark { fill: var(--oro-claro); }
  .hero__glow {
    position: absolute;
    inset: 18%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(230 205 148 / 0.4), rgb(0 74 173 / 0.15) 60%, transparent);
    filter: blur(20px);
  }
  .hero__cover {
    position: relative;
    width: 84%;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .hero__cover :global(img) {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 40px 50px rgb(0 0 0 / 0.55));
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
  }
  .hero__scroll span {
    width: 1px;
    height: 2.25rem;
    background: linear-gradient(var(--oro), transparent);
    animation: drip 2.4s var(--ease-out) infinite;
    transform-origin: top;
  }
  @keyframes drip { 0% { transform: scaleY(0); } 60% { transform: scaleY(1); opacity: 1; } 100% { transform: scaleY(1); opacity: 0; } }

  @media (max-width: 899px) {
    .hero { padding-top: calc(6rem + env(safe-area-inset-top)); align-items: start; }
    .hero__grid { grid-template-columns: 1fr; gap: 0; }
    .hero__title { font-size: clamp(2.6rem, 1rem + 7vw, 4.25rem); }
    .hero__sub { font-size: var(--s-1); }
    .hero__book { order: 2; width: min(80%, 22rem); margin-top: 1.5rem; }
    .hero__cta { order: 3; margin-top: 1.5rem; }
    .hero__copy { display: contents; }
    .hero__scroll { display: none; }
  }
</style>
