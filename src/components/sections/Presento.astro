---
import { Picture } from 'astro:assets';
import mockup from '../../assets/img/mockup-dispositivos.png';
import { presento, cta } from '../../content/landing';
import CtaButton from '../CtaButton.astro';

const gems = ['var(--gema-zafiro)', 'var(--gema-esmeralda)', 'var(--gema-amatista)', 'var(--gema-rubi)'];
---
<section class="pre sec is-pearl" aria-labelledby="presento-title">
  <div class="wrap">
    <header class="pre__head">
      <p class="pre__kicker t-lirica t-2">{presento.kicker}</p>
      <h2 id="presento-title" class="t-display t-4">{presento.title}</h2>
      <p class="pre__sub t-1 muted">{presento.subtitle}</p>
    </header>

    <div class="pre__mock" data-scale-in>
      <Picture
        src={mockup}
        formats={['avif', 'webp']}
        widths={[640, 1000, 1400, 1920]}
        sizes="(min-width: 1320px) 1200px, 94vw"
        alt="El ebook abierto en computador, tablet y celular: se puede leer en cualquier dispositivo"
      />
    </div>

    <div class="pre__grid">
      <p class="pre__statement t-display t-3">{presento.statement}</p>
      <div>
        <p class="pre__intro">{presento.intro}</p>
        <ul class="pre__benefits" role="list">
          {presento.benefits.map((b, i) => (
            <li style={`--gem:${gems[i]}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0C12.8 8 16 11.2 24 12 16 12.8 12.8 16 12 24 11.2 16 8 12.8 0 12 8 11.2 11.2 8 12 0Z" /></svg>
              <span>{b}</span>
            </li>
          ))}
        </ul>
        <CtaButton label={cta.moment} id="presento" variant="noche" />
      </div>
    </div>
  </div>
</section>

<style>
  .pre__head { text-align: center; max-width: 60rem; margin-inline: auto; }
  .pre__head h2 { color: var(--noche); max-width: 18ch; margin-inline: auto; }
  .pre__kicker { color: var(--oro-tinta); margin-bottom: 0.4em; }
  .pre__sub { margin: 1.25rem auto 0; max-width: 40ch; }
  .pre__mock { margin: clamp(2.5rem, 6vw, 5rem) auto; max-width: 1200px; }
  .pre__mock :global(img) { width: 100%; height: auto; filter: drop-shadow(0 50px 50px rgb(10 23 51 / 0.2)); }

  .pre__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .pre__statement { color: var(--noche); max-width: 14ch; }
  .pre__intro { color: var(--tinta-2); max-width: 42ch; }
  .pre__benefits { margin: 1.75rem 0 2.5rem; display: grid; gap: 0.2rem; }
  .pre__benefits li {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding-block: 0.7rem;
    font-family: var(--f-display);
    font-weight: 500;
    font-size: var(--s-2);
    line-height: 1.15;
    color: var(--noche);
    border-bottom: 1px solid rgb(17 28 56 / 0.1);
  }
  .pre__benefits svg {
    flex: none;
    width: 0.6em;
    height: 0.6em;
    color: var(--gem);
    transform: translateY(-0.05em);
    transition: transform 0.6s var(--ease-out);
  }
  .pre__benefits li:hover svg { transform: rotate(90deg) scale(1.3); }
  @media (max-width: 799px) {
    .pre__grid { grid-template-columns: 1fr; }
  }
</style>
