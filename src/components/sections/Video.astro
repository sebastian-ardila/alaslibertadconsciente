---
import { video, cta } from '../../content/landing';
import YouTubeFacade from '../YouTubeFacade.astro';
import CtaButton from '../CtaButton.astro';
---
<section class="vid sec is-night" id="video" aria-labelledby="video-title">
  <div class="vid__grid wrap">
    <div class="vid__media" data-thread="left">
      <YouTubeFacade title="Claudia Palacio presenta Un Encuentro con los 7 Arcángeles" />
    </div>
    <div class="vid__copy">
      <h2 id="video-title" class="vid__quote t-lirica">
        {video.quote}
      </h2>
      <CtaButton label={cta.guided} id="video" />
    </div>
  </div>
</section>

<style>
  .vid { padding-top: clamp(3rem, 6vw, 5rem); }
  .vid__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .vid__quote {
    font-size: clamp(1.7rem, 1.1rem + 1.9vw, 2.9rem);
    color: var(--alba);
    line-height: 1.18;
    padding-left: 1.25rem;
    border-left: 2px solid var(--oro);
  }
  .vid__copy :global(.btn) { margin-top: 2.25rem; margin-left: 1.25rem; }
  @media (max-width: 899px) {
    .vid__grid { grid-template-columns: 1fr; }
    .vid__copy { padding-top: 1.5rem; }
  }
</style>
