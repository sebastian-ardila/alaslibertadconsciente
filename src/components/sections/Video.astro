---
import { hero, video, cta } from '../../content/landing';
import YouTubeFacade from '../YouTubeFacade.astro';
import CtaButton from '../CtaButton.astro';
---
<section class="vid sec is-night" id="video" aria-labelledby="video-title">
  <div class="wrap">
    <div class="vid__promise">
      <p class="vid__lead t-display">{hero.lead}</p>
      <p class="vid__body t-1">{hero.body}</p>
    </div>

    <div class="vid__grid">
      <div class="vid__media">
        <YouTubeFacade title="Claudia Palacio presenta Un Encuentro con los 7 Arcángeles" />
      </div>
      <div class="vid__copy">
        <h2 id="video-title" class="vid__quote t-lirica">{video.quote}</h2>
        <CtaButton label={cta.guided} id="video" />
      </div>
    </div>
  </div>
</section>

<style>
  .vid__promise {
    max-width: 52rem;
    margin: 0 auto clamp(4rem, 9vw, 7rem);
    text-align: center;
  }
  .vid__lead {
    font-size: var(--s-3);
    font-weight: 400;
    line-height: 1.15;
    color: var(--perla);
    text-wrap: balance;
  }
  .vid__body {
    margin: 1.5rem auto 0;
    max-width: 36ch;
    color: var(--oro-claro);
  }

  .vid__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .vid__quote {
    font-size: clamp(1.6rem, 1.1rem + 1.6vw, 2.6rem);
    line-height: 1.2;
    color: var(--alba);
    padding-left: 1.25rem;
    border-left: 2px solid var(--oro);
  }
  .vid__copy :global(.btn) { margin-top: 2.25rem; margin-left: 1.25rem; }
  @media (max-width: 899px) {
    .vid__grid { grid-template-columns: 1fr; }
    .vid__copy { padding-top: 1rem; }
  }
  @media (max-width: 559px) {
    .vid__copy :global(.btn) { margin-left: 0; }
  }
</style>
