---
import { CHECKOUT_URL, PRODUCT, WHATSAPP_URL, whatsapp } from '../content/landing';
import WhatsAppIcon from './WhatsAppIcon.astro';
---
<div class="sticky" data-sticky aria-hidden="true" inert>
  <p class="sticky__price">
    <span class="t-display">${PRODUCT.price} {PRODUCT.currency}</span>
    <span class="sticky__sub">Acceso inmediato</span>
  </p>
  <a class="sticky__wa" href={WHATSAPP_URL} target="_blank" rel="noopener" aria-label={`${whatsapp.label} (se abre en una pestaña nueva)`}>
    <WhatsAppIcon />
  </a>
  <a class="btn sticky__btn" href={CHECKOUT_URL} data-cta="barra-movil" target="_blank" rel="noopener">Comprar ahora<span class="sr-only"> (se abre en una pestaña nueva)</span></a>
</div>

<style>
  .sticky {
    position: fixed;
    inset: auto 0 0;
    z-index: 45;
    display: none;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem var(--gutter) calc(0.75rem + env(safe-area-inset-bottom));
    background: rgb(6 14 34 / 0.94);
    color: var(--alba);
    border-top: 1px solid rgb(200 161 90 / 0.35);
    backdrop-filter: blur(10px);
    translate: 0 110%;
    transition: translate 0.45s var(--ease-out);
  }
  .sticky.is-visible { translate: 0 0; }
  .sticky__price { display: grid; line-height: 1.1; margin-right: auto; }
  .sticky__wa {
    display: grid;
    place-items: center;
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid rgb(230 205 148 / 0.45);
    color: var(--oro-claro);
  }
  .sticky__wa :global(svg) { width: 1.35rem; height: 1.35rem; }
  .sticky__price .t-display { font-size: 1.6rem; }
  .sticky__sub { font-size: 0.78rem; color: var(--niebla); white-space: nowrap; }
  .sticky__btn { width: auto; flex: none; min-height: 3rem; padding: 0.75rem 1.5rem; font-size: 1rem; }
  @media (max-width: 767px) { .sticky { display: flex; } }
</style>
