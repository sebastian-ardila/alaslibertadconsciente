---
import { CHECKOUT_URL, PRODUCT } from '../content/landing';
---
<div class="sticky" data-sticky aria-hidden="true" inert>
  <p class="sticky__price">
    <span class="t-display">${PRODUCT.price} {PRODUCT.currency}</span>
    <span class="sticky__sub">Acceso inmediato</span>
  </p>
  <a class="btn sticky__btn" href={CHECKOUT_URL} data-cta="barra-movil">Comprar ahora</a>
</div>

<style>
  .sticky {
    position: fixed;
    inset: auto 0 0;
    z-index: 45;
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem var(--gutter) calc(0.75rem + env(safe-area-inset-bottom));
    background: rgb(6 14 34 / 0.94);
    color: var(--alba);
    border-top: 1px solid rgb(200 161 90 / 0.35);
    backdrop-filter: blur(10px);
    translate: 0 110%;
    transition: translate 0.45s var(--ease-out);
  }
  .sticky.is-visible { translate: 0 0; }
  .sticky__price { display: grid; line-height: 1.1; }
  .sticky__price .t-display { font-size: 1.6rem; }
  .sticky__sub { font-size: var(--s--1); color: var(--niebla); }
  .sticky__btn { min-height: 3rem; padding: 0.75rem 1.5rem; font-size: 1rem; }
  @media (max-width: 767px) { .sticky { display: flex; } }
</style>
