---
// Campo de estrellas en capas, generado en build con semilla fija (sin JS en el cliente).
// Cada capa lleva data-depth para el parallax.
interface Props { seed?: number; density?: number; class?: string }
const { seed = 7, density = 1, class: cls } = Astro.props;

function rng(s: number) {
  return () => ((s = (s * 16807) % 2147483647) - 1) / 2147483646;
}
const r = rng(seed);
const layers = [
  { depth: 0.15, n: Math.round(55 * density), size: [0.8, 1.6], op: [0.25, 0.6] },
  { depth: 0.35, n: Math.round(28 * density), size: [1.2, 2.4], op: [0.4, 0.85] },
  { depth: 0.6, n: Math.round(7 * density), size: [7, 14], op: [0.55, 0.95], glyph: true },
].map((l) => ({
  ...l,
  stars: Array.from({ length: l.n }, () => ({
    x: r() * 1000,
    y: r() * 1000,
    s: l.size[0] + r() * (l.size[1] - l.size[0]),
    o: l.op[0] + r() * (l.op[1] - l.op[0]),
    twinkle: r() > 0.8,
  })),
}));
---
<div class:list={['sf', cls]} aria-hidden="true">
  {layers.map((l) => (
    <svg class="sf__layer" data-depth={l.depth} viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice">
      {l.stars.map((st) =>
        l.glyph ? (
          <path
            fill="#e6cd94"
            opacity={st.o.toFixed(2)}
            transform={`translate(${st.x.toFixed(1)} ${st.y.toFixed(1)}) scale(${(st.s / 24).toFixed(3)})`}
            d="M12 0C12.8 8 16 11.2 24 12 16 12.8 12.8 16 12 24 11.2 16 8 12.8 0 12 8 11.2 11.2 8 12 0Z"
          />
        ) : (
          <circle
            class={st.twinkle ? 'tw' : undefined}
            cx={st.x.toFixed(1)}
            cy={st.y.toFixed(1)}
            r={(st.s / 2).toFixed(2)}
            fill="#e8eef7"
            opacity={st.o.toFixed(2)}
            style={st.twinkle ? `animation-delay:${(-st.x / 100).toFixed(1)}s` : undefined}
          />
        ),
      )}
    </svg>
  ))}
</div>

<style>
  .sf { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .sf__layer { position: absolute; inset: -12% 0; width: 100%; height: 124%; }
  .tw { animation: tw 4.5s ease-in-out infinite alternate; }
  @keyframes tw { to { opacity: 0.1; } }
</style>
