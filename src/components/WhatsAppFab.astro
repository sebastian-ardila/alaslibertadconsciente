---
import { WHATSAPP_URL, whatsapp } from '../content/landing';
import WhatsAppIcon from './WhatsAppIcon.astro';
---
<a class="wa" href={WHATSAPP_URL} target="_blank" rel="noopener" aria-label={`${whatsapp.label} (se abre en una pestaña nueva)`} data-wa>
  <WhatsAppIcon />
</a>

<style>
  .wa {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: calc(1rem + env(safe-area-inset-bottom));
    z-index: 40;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--perla);
    color: #128c4a;
    box-shadow: 0 10px 30px -8px rgb(0 0 0 / 0.45);
    transition: transform 0.3s var(--ease-out), opacity 0.3s, visibility 0.3s;
  }
  .wa :global(svg) { width: 1.6rem; height: 1.6rem; }
  .wa:hover { transform: scale(1.07); }
  /* En móvil sube para no tapar la barra de compra fija */
  @media (max-width: 767px) {
    :global(body.has-sticky) .wa { opacity: 0; visibility: hidden; transform: scale(0.6); }
  }
</style>
