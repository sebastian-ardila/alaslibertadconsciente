---
// Carga el iframe de YouTube solo cuando la persona pulsa "reproducir" (mejor LCP y privacidad).
import { Image } from 'astro:assets';
import poster from '../assets/img/video-poster.jpg';
import { YOUTUBE_ID } from '../content/landing';

interface Props { title: string }
const { title } = Astro.props;
---
<div class="yt" data-yt={YOUTUBE_ID} data-yt-title={title}>
  <Image src={poster} alt="" widths={[640, 960, 1280]} sizes="(min-width: 1100px) 60vw, 92vw" class="yt__poster" />
  <button type="button" class="yt__play" aria-label={`Reproducir video: ${title}`}>
    <span class="yt__ring" aria-hidden="true"></span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5.5v13l10.5-6.5z" /></svg>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.yt}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
      iframe.title = el.dataset.ytTitle ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
      el.classList.add('is-playing');
      iframe.focus();
    }, { once: true });
  });
</script>

<style>
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 0.75rem;
    background: var(--noche-hondo);
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.8);
  }
  .yt :global(img), .yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }
  .yt__poster { transition: transform 1.2s var(--ease-out), filter 0.6s; filter: saturate(0.9); }
  .yt__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: linear-gradient(180deg, transparent 40%, rgb(6 14 34 / 0.45));
    color: var(--noche);
  }
  .yt__play svg {
    position: relative;
    width: clamp(4.5rem, 9vw, 6.5rem);
    padding: 1.4rem 1.2rem 1.4rem 1.6rem;
    background: var(--oro-claro);
    border-radius: 50%;
    transition: transform 0.4s var(--ease-out), background-color 0.3s;
  }
  .yt__ring {
    position: absolute;
    width: clamp(6.5rem, 13vw, 9.5rem);
    aspect-ratio: 1;
    border: 1px solid rgb(230 205 148 / 0.7);
    border-radius: 50%;
    animation: ring 3.2s var(--ease-out) infinite;
  }
  @keyframes ring { from { transform: scale(0.7); opacity: 1; } to { transform: scale(1.35); opacity: 0; } }
  .yt:hover .yt__poster { transform: scale(1.03); }
  .yt__play:hover svg, .yt__play:focus-visible svg { transform: scale(1.08); background: var(--perla); }
  .yt__play:focus-visible { outline-offset: -6px; }
</style>
