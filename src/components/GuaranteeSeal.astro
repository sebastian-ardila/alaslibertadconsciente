---
// Sello grabado en oro, dibujado en SVG (reemplaza la insignia con cinta roja del original).
---
<div class="seal" aria-hidden="true">
  <svg viewBox="0 0 300 300" class="seal__svg">
    <defs>
      <path id="seal-circle" d="M150 150m-118 0a118 118 0 1 1 236 0a118 118 0 1 1-236 0" />
      <radialGradient id="seal-fill" cx="50%" cy="35%" r="70%">
        <stop offset="0" stop-color="#16295a" />
        <stop offset="1" stop-color="#0a1733" />
      </radialGradient>
    </defs>
    <circle cx="150" cy="150" r="146" fill="url(#seal-fill)" stroke="#c8a15a" stroke-width="1.5" />
    <circle cx="150" cy="150" r="136" fill="none" stroke="#c8a15a" stroke-width="0.75" stroke-dasharray="2 5" />
    <circle cx="150" cy="150" r="96" fill="none" stroke="#c8a15a" stroke-width="0.75" />
    <g class="seal__ring">
      <text font-family="Hanken Grotesk Variable, sans-serif" font-size="15" font-weight="600" letter-spacing="3.2" fill="#e6cd94">
        <textPath href="#seal-circle">GARANTÍA DE 7 DÍAS ✦ REEMBOLSO COMPLETO ✦ SIN PREGUNTAS ✦</textPath>
      </text>
    </g>
    <text x="150" y="182" text-anchor="middle" font-family="Josefin Sans Variable, sans-serif" font-weight="600" font-size="112" fill="#e6cd94">7</text>
    <text x="150" y="212" text-anchor="middle" font-family="Josefin Sans Variable, sans-serif" font-style="italic" font-weight="300" font-size="21" fill="#c8a15a">días</text>
    <path d="M150 64c.6 6 3 8.4 9 9-6 .6-8.4 3-9 9-.6-6-3-8.4-9-9 6-.6 8.4-3 9-9z" fill="#c8a15a" />
  </svg>
</div>

<style>
  .seal { width: min(100%, 22rem); aspect-ratio: 1; }
  .seal__svg { width: 100%; height: 100%; overflow: visible; filter: drop-shadow(0 30px 50px rgb(0 0 0 / 0.45)); }
  .seal__ring { transform-origin: 150px 150px; }
</style>
